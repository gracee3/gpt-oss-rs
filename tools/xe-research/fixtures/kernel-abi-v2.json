{
  "schema": "gpt-oss-rs.xe-kernel-abi/v2",
  "supersedes_for_xe_v2_entries": "gpt-oss-rs.xe-kernel-abi/v1",
  "cache_identity": [
    "backend_format",
    "kernel_source_sha256",
    "compiler_path_and_sha256",
    "compiler_version",
    "build_options",
    "vendor_id",
    "device_id",
    "driver_library_path_and_sha256",
    "driver_api_version",
    "entry_point",
    "abi_schema"
  ],
  "argument_sets": {
    "mxfp4_exact_blocks_v2": [
      {"index": 0, "name": "weights", "type": "u8", "size": "pointer", "address_space": "global", "alignment": 1, "mutability": "const", "extent": "round_up(count, 32) * 17"},
      {"index": 1, "name": "activations", "type": "activation_record_v2", "size": "pointer", "address_space": "global", "alignment": 8, "mutability": "const", "extent": "count * 72"},
      {"index": 2, "name": "primary_integer", "type": "i32", "size": "pointer", "address_space": "global", "alignment": 4, "mutability": "write", "extent": "count * 4"},
      {"index": 3, "name": "residual_integer", "type": "i32", "size": "pointer", "address_space": "global", "alignment": 4, "mutability": "write", "extent": "count * 4"},
      {"index": 4, "name": "q8_output", "type": "f32", "size": "pointer", "address_space": "global", "alignment": 4, "mutability": "write", "extent": "count * 4"},
      {"index": 5, "name": "residual_q8_output", "type": "f32", "size": "pointer", "address_space": "global", "alignment": 4, "mutability": "write", "extent": "count * 4"},
      {"index": 6, "name": "count", "type": "u32", "size": 4, "address_space": "value", "alignment": 4, "mutability": "const", "extent": "one value"}
    ],
    "mxfp4_project_v2": [
      {"index": 0, "name": "weights", "type": "u8", "size": "pointer", "address_space": "global", "alignment": 1, "mutability": "const", "extent": "columns * blocks * 17"},
      {"index": 1, "name": "activations", "type": "activation_record_v2", "size": "pointer", "address_space": "global", "alignment": 8, "mutability": "const", "extent": "rows * blocks * 72"},
      {"index": 2, "name": "bias", "type": "f32", "size": "pointer", "address_space": "global", "alignment": 4, "mutability": "const", "extent": "columns * 4"},
      {"index": 3, "name": "output", "type": "f32", "size": "pointer", "address_space": "global", "alignment": 4, "mutability": "write", "extent": "rows * columns * 4"},
      {"index": 4, "name": "rows", "type": "u32", "size": 4, "address_space": "value", "alignment": 4, "mutability": "const", "extent": "one value"},
      {"index": 5, "name": "columns", "type": "u32", "size": 4, "address_space": "value", "alignment": 4, "mutability": "const", "extent": "one value"},
      {"index": 6, "name": "blocks", "type": "u32", "size": 4, "address_space": "value", "alignment": 4, "mutability": "const", "extent": "one value"}
    ],
    "mxfp4_splitk_terms_v2": [
      {"index": 0, "name": "weights", "type": "u8", "size": "pointer", "address_space": "global", "alignment": 1, "mutability": "const", "extent": "columns * blocks * 17"},
      {"index": 1, "name": "activations", "type": "activation_record_v2", "size": "pointer", "address_space": "global", "alignment": 8, "mutability": "const", "extent": "rows * blocks * 72"},
      {"index": 2, "name": "terms", "type": "f32", "size": "pointer", "address_space": "global", "alignment": 4, "mutability": "write", "extent": "rows * columns * blocks * 2 * 4"},
      {"index": 3, "name": "rows", "type": "u32", "size": 4, "address_space": "value", "alignment": 4, "mutability": "const", "extent": "one value"},
      {"index": 4, "name": "columns", "type": "u32", "size": 4, "address_space": "value", "alignment": 4, "mutability": "const", "extent": "one value"},
      {"index": 5, "name": "blocks", "type": "u32", "size": 4, "address_space": "value", "alignment": 4, "mutability": "const", "extent": "one value"}
    ],
    "mxfp4_splitk_reduce_v2": [
      {"index": 0, "name": "terms", "type": "f32", "size": "pointer", "address_space": "global", "alignment": 4, "mutability": "const", "extent": "rows * columns * blocks * 2 * 4"},
      {"index": 1, "name": "bias", "type": "f32", "size": "pointer", "address_space": "global", "alignment": 4, "mutability": "const", "extent": "columns * 4"},
      {"index": 2, "name": "output", "type": "f32", "size": "pointer", "address_space": "global", "alignment": 4, "mutability": "write", "extent": "rows * columns * 4"},
      {"index": 3, "name": "rows", "type": "u32", "size": 4, "address_space": "value", "alignment": 4, "mutability": "const", "extent": "one value"},
      {"index": 4, "name": "columns", "type": "u32", "size": 4, "address_space": "value", "alignment": 4, "mutability": "const", "extent": "one value"},
      {"index": 5, "name": "blocks", "type": "u32", "size": 4, "address_space": "value", "alignment": 4, "mutability": "const", "extent": "one value"}
    ]
  },
  "entry_points": {
    "mxfp4_exact_blocks_v2": {"argument_set": "mxfp4_exact_blocks_v2", "global_size": ["round_up(count, 32)", 1, 1], "local_size": [32, 1, 1], "subgroup": 32, "k": 32},
    "mxfp4_tile32_m1_v2": {"argument_set": "mxfp4_project_v2", "global_size": ["round_up(columns, local_x)", "rows", 1], "local_size": ["32|64|128", 1, 1], "subgroup": 32, "rows_per_weight_decode": 1},
    "mxfp4_tile32_m2_v2": {"argument_set": "mxfp4_project_v2", "global_size": ["round_up(columns, local_x)", "rows / 2", 1], "local_size": ["32|64|128", 1, 1], "subgroup": 32, "rows_per_weight_decode": 2},
    "mxfp4_tile32_m4_v2": {"argument_set": "mxfp4_project_v2", "global_size": ["round_up(columns, local_x)", "rows / 4", 1], "local_size": ["32|64|128", 1, 1], "subgroup": 32, "rows_per_weight_decode": 4},
    "mxfp4_splitk_terms_v2": {"argument_set": "mxfp4_splitk_terms_v2", "global_size": ["round_up(columns, local_x)", "blocks", "rows"], "local_size": ["32|64|128", 1, 1], "subgroup": 32},
    "mxfp4_splitk_reduce_v2": {"argument_set": "mxfp4_splitk_reduce_v2", "global_size": ["round_up(columns, local_x)", "rows", 1], "local_size": ["32|64|128", 1, 1], "subgroup": 32, "reduction_order": "for each K block: primary then residual"}
  },
  "rules": {
    "weight_layout": "[output-tile][K-block][17 planes][32 lanes]; plane 0 is E8M0 scale and planes 1-16 are canonical low-nibble-first packed bytes",
    "activation_layout": "one 8-byte-aligned 72-byte record per row and K block: primary i8[32], residual i8[32], primary FP32 scale, residual FP32 scale",
    "weight_residency": "the v2 representation replaces canonical packed/scales buffers for a v2 session; duplicate device weight residency is forbidden",
    "splitk_scratch": "two FP32 terms per row, output, and K block; maximum runnable M is 2 and maximum scratch is 8294400 bytes",
    "shape_policy": "K must be divisible by 32, columns must be divisible by 32, m2 rows must be divisible by 2, m4 rows must be divisible by 4, and splitk accepts only M=1 or M=2",
    "aliasing": "write buffers must not overlap any input or each other",
    "fast_math": false,
    "fp_contract": false,
    "native_binary": "runtime evidence/cache only, never portable or checked in"
  }
}
